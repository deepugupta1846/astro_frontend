5:["$","section","3. How to request account deletion",{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground md:text-xl","children":"3. How to request account deletion"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","Website (no app login required): open the Delete",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Website (no app login required): open the Delete Account page at /delete-account, enter your registered mobile number, verify with a one-time password (OTP), and submit the request. You may optionally add a reason."}],["$","p","Mobile app: open Profile or the side menu, choos",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Mobile app: open Profile or the side menu, choose Delete account, verify with OTP, and submit the request."}],["$","p","Email: write to support from your registered ema",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Email: write to support from your registered email or phone number stating that you want your account deleted. We may ask for OTP or other verification before processing."}],["$","p","End any active chat or call consultations before",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"End any active chat or call consultations before submitting. Incomplete requests or unverified identities may be delayed or declined until we can confirm the account owner."}]]}]]}]
6:["$","section","4. Deleting specific data without closing the account",{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground md:text-xl","children":"4. Deleting specific data without closing the account"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","You may ask us to correct or remove certain prof",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"You may ask us to correct or remove certain profile or birth-chart details while keeping your account, where technically feasible and not needed to provide an ongoing service you still use."}],["$","p","Email us with the data you want removed (for exa",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Email us with the data you want removed (for example, a specific kundli profile). We will confirm what can be deleted versus what must remain for an active account (such as payment history for open disputes)."}]]}]]}]
7:["$","section","5. What happens after you submit a request",{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground md:text-xl","children":"5. What happens after you submit a request"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","Your account is temporarily deactivated. You wil",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Your account is temporarily deactivated. You will not be able to log in while the request is pending."}],["$","p","Temporary deactivation or “freezing” is not the ",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Temporary deactivation or “freezing” is not the final outcome. Once the request is approved, we permanently delete personal data associated with the account as described below."}],["$","p","Our team reviews the request (including identity",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Our team reviews the request (including identity verification and any open sessions or fraud checks). You may contact support before processing completes if you wish to cancel the request."}]]}]]}]
8:["$","section","6. Data we delete",{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground md:text-xl","children":"6. Data we delete"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","When account deletion is completed, we delete or",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"When account deletion is completed, we delete or irreversibly anonymise personal data we control that is linked to your account, including:"}],["$","p","Account and profile information (name, mobile nu",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Account and profile information (name, mobile number, email, profile photo, preferences)."}],["$","p","Birth and chart data (date, time, and place of b",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Birth and chart data (date, time, and place of birth; kundli and matchmaking inputs and results you generated)."}],["$","p","Consultation-related content and metadata we sto",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Consultation-related content and metadata we store (chat/call history and session records associated with your user ID), subject to any limited retention noted in section 7."}],["$","p","Wallet balance and in-app promotional credits ti",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Wallet balance and in-app promotional credits tied to the account."}],["$","p","Device and push-notification tokens linked to th",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Device and push-notification tokens linked to the account."}]]}]]}]
9:["$","section","7. Data we may retain",{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground md:text-xl","children":"7. Data we may retain"}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","p","We do not keep your account in a frozen state as",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"We do not keep your account in a frozen state as a substitute for deletion. However, we may retain limited information where necessary for legal, tax, accounting, fraud prevention, security, or dispute-resolution purposes. Examples include payment gateway transaction references, invoices, refund records, and records of abuse or chargebacks."}],["$","p","Such retained data is restricted to what is reas",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Such retained data is restricted to what is reasonably needed, kept only for as long as required for that purpose or by applicable law, and is not used to market to you."}],["$","p","Aggregated or anonymised statistics that cannot ",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Aggregated or anonymised statistics that cannot reasonably identify you may be retained for analytics and product improvement."}],["$","p","Astrologers may retain limited consultation note",{"className":"text-sm leading-relaxed text-muted md:text-base","children":"Astrologers may retain limited consultation notes they created as independent service providers only where needed for their own compliance; we instruct processors and partners under our control to delete or anonymise personal data in line with this policy."}]]}]]}]
